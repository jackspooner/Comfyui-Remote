# Inbound roles are deliberately disabled by default. Restart ComfyUI after changes.
CUTLERY_REMOTE_SERVER_ENABLED=0
CUTLERY_REMOTE_CLIP_SERVER_ENABLED=0

# Set the same non-empty value on trusted peers. Never commit a real token.
CUTLERY_REMOTE_TOKEN=replace-with-a-long-random-token
# Maximum JSON response buffered from a trusted generic Remote peer before decoding.
# The 384 MiB default accommodates the 256 MiB aggregate media boundary after base64 transport.
# This must be a positive whole number of MiB; invalid or zero values stop Remote requests.
CUTLERY_REMOTE_RESPONSE_LIMIT_MB=384

# A trusted outbound target must also appear in CUTLERY_DATA_DIR/config.json.
CUTLERY_REMOTE_CLIP_MODE=direct
CUTLERY_REMOTE_CLIP_TIMEOUT_S=60
CUTLERY_REMOTE_CLIP_ENCODE_TIMEOUT_S=600
CUTLERY_REMOTE_CLIP_LORA_UPLOAD_LIMIT_MB=4096
CUTLERY_REMOTE_CLIP_FILE_UPLOAD_LIMIT_MB=2048
# Maximum JSON response buffered from a trusted Remote CLIP peer before decoding.
CUTLERY_REMOTE_CLIP_RESPONSE_LIMIT_MB=256

# Optional absolute location for mutable blobs, model digests, and peer configuration.
# CUTLERY_DATA_DIR=C:\\ComfyUIData\\CutleryRemote
